# AI-Enhanced Todo Management System Environment Configuration

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ai-todo-management
# For MongoDB Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-todo-management

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Next.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Application Configuration
NODE_ENV=development
