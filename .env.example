# AI-Enhanced Todo Management System Environment Configuration

# Database Configuration
DATABASE_URL=sqlite:///./ai_todo_management.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost/ai_todo_db

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
USE_LOCAL_MODELS=true

# Parallel Processing Configuration
MAX_WORKERS=4
BATCH_SIZE=20
MAX_CONCURRENT_BATCHES=3
PROCESSING_TIMEOUT=300

# NLP Configuration
SPACY_MODEL=en_core_web_sm
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Application Configuration
APP_NAME=AI-Enhanced Todo Management
APP_VERSION=1.0.0
DEBUG=false
